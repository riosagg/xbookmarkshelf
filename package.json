{
  "name": "xbookmarkshelf",
  "version": "0.1.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "node tools/build.mjs && node tools/build-local.mjs",
    "build:local": "node tools/build-local.mjs",
    "licenses:check": "node tools/licenses.mjs --check",
    "check": "npm run typecheck && npm test && npm run build && npm run licenses:check"
  },
  "dependencies": { "dexie": "4.4.7", "preact": "11.1.0" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
